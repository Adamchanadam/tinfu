{
  "name": "tinfu",
  "version": "1.0.6",
  "description": "天賦（Tinfu）：本地紫微斗數插件：用真太陽時排盤，用廣東話或者台灣華語淺白解答自己嘅分析、今年同未來幾年；出生時間唔肯定就問舊事核對。分析只存喺本機。免費，所有功能唔使授權碼。",
  "author": {
    "name": "Adam Chan"
  },
  "license": "UNLICENSED",
  "keywords": ["ziwei", "紫微斗數", "cantonese", "taiwanese-mandarin", "astrology"],
  "mcpServers": {
    "ziwei-local": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/server.js"],
      "env": {
        "ZIWEI_DATA_DIR": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
